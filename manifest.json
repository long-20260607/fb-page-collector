{
  "manifest_version": 3,
  "name": "FB Page Collector",
  "version": "1.0.0",
  "description": "Collect page entries from the current Facebook view and export them to a sheet",

  "action": {
    "default_popup": "popup.html"
  },

  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["lib/xlsx.full.min.js", "content.js"],
      "run_at": "document_idle"
    }
  ],

  "permissions": ["tabs", "storage", "scripting", "activeTab"],
  "host_permissions": ["<all_urls>"]
}
